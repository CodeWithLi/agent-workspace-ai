# Copy this file to backend/dependencies.env after installing the services.
# For a default local installation, only replace CHANGE_ME values.

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/agent_workspace_ai

# Redis and Milvus use their standard local ports.
REDIS_URL=redis://127.0.0.1:6379/0
MILVUS_HOST=127.0.0.1

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME

# Optional: fill these only when email delivery is required.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
