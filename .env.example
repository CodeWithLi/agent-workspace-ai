SECRET_KEY=please-change-this-secret
ENVIRONMENT=development
AUTO_CREATE_SCHEMA=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOW_REGISTRATION=true
FIRST_SUPERUSER_EMAIL=
